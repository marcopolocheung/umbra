{
  "name": "@umbra/shadow-prep",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "pretest": "node ../../scripts/preflight-shadow-v2.mjs prep",
    "preadmit": "node ../../scripts/preflight-shadow-v2.mjs prep",
    "prebuild": "node ../../scripts/preflight-shadow-v2.mjs prep",
    "preverify": "node ../../scripts/preflight-shadow-v2.mjs prep",
    "admit": "tsx src/cli.ts admit",
    "acquire:plan": "tsx src/cli.ts acquire --plan",
    "acquire": "tsx src/cli.ts acquire --execute",
    "controls": "tsx src/cli.ts controls",
    "approve-controls": "tsx src/cli.ts approve-controls",
    "receipts": "tsx src/cli.ts receipts",
    "normalize": "tsx src/cli.ts normalize",
    "pack:benchmark": "tsx src/pack-cli.ts",
    "build": "tsx src/cli.ts build",
    "verify": "tsx src/cli.ts verify",
    "test": "tsx --test test/*.test.ts",
    "test:container-smoke": "bash test/container-smoke.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@duckdb/node-api": "1.5.5-r.5"
  }
}
