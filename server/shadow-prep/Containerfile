FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gdal-bin proj-bin proj-data unzip ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY server/shadow-prep/package.json server/shadow-prep/package-lock.json ./server/shadow-prep/
RUN cd server/shadow-prep && npm ci
COPY app ./app
COPY scripts/preflight-shadow-v2.mjs ./scripts/preflight-shadow-v2.mjs
COPY server/shadow-prep ./server/shadow-prep
ENV SHADE_PREP_ROOT=/data
ENTRYPOINT ["node", "server/shadow-prep/node_modules/tsx/dist/cli.mjs", "server/shadow-prep/src/cli.ts"]
