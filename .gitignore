# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template, which holds names and no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
.worktrees/

# local Claude dev notes
CLAUDE.local.md

# Browser-verification output (see docs/notes/browser-verification.md)
out/

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Publisher PDFs read for docs/research/*.md analyses. Kept locally, never committed:
# they are Elsevier copyright ("All rights are reserved"), ~35 MB, and this repo is
# publicly mirrored. The reconciliation notes cite them; the files stay out.
docs/research/shadowstudy*.pdf

# Local scratch: app screenshots kept for reference, not repo content.
issues/

# Downloaded GIS sources and immutable local shadow-preparation generations must
# live outside this checkout. This catches an accidental in-repository mount.
/server/shadow-prep/local/
/server/shadow-prep/node_modules/
/shade-prep-data/
