{
  // Standalone Worker project: workerd runtime types, not DOM. The root
  // tsconfig covers the browser app with DOM libs, so this tree is excluded
  // there and checked here instead — full R2 API contract included.
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["esnext"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
